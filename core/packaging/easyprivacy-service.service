[Unit]
Description=EasyPrivacy home service node
After=network-online.target ufw.service systemd-tmpfiles-setup.service
Wants=network-online.target
ConditionPathExists=/var/lib/easyprivacy-service/service.json

[Service]
Type=exec
User=root
Group=root
RuntimeDirectory=easyprivacy-service
RuntimeDirectoryMode=0755
ExecStartPre=/usr/bin/easyprivacy-node service-cleanup
ExecStart=/usr/bin/easyprivacy-node service-serve
ExecStopPost=/usr/bin/easyprivacy-node service-cleanup
Restart=on-failure
RestartSec=10
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/easyprivacy-service /run/xtables.lock
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_NET_ADMIN
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
